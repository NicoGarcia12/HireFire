# Servidor
PORT=3000

# Base de datos PostgreSQL (instalado localmente)
DATABASE_URL=postgresql://hirefire:hirefire@localhost:5432/hirefire?schema=public

# Apify — https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxx
APIFY_JOBS_ACTOR=curious_coder/linkedin-jobs-scraper

# Groq (matching) — https://console.groq.com/keys  |  tier gratuito disponible
# Modelos vigentes (ago-2026): openai/gpt-oss-120b, openai/gpt-oss-20b.
# Si vuelve a dar 404 "model not found", revisá https://console.groq.com/docs/models
GROQ_API_KEY=gsk_xxx
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (opcional) — fallback gratuito si Groq falla (rate limit, modelo caído, etc.)
# https://openrouter.ai/keys | dejar OPENROUTER_API_KEY vacío/sin definir desactiva el fallback.
# Roster de modelos ":free" rota seguido: https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
