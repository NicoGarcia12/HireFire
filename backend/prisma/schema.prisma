generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id           String        @id @default(uuid())
  headline     String
  summary      String        @default("")
  skills       String[]
  locations    String[]
  remote       Boolean       @default(false)
  seniority    String?
  experience   Experience[]
  searches     Search[]
  savedSearches SavedSearch[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Experience {
  id          String  @id @default(uuid())
  title       String
  company     String
  description String  @default("")
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
}

// Historial: cada búsqueda completa ejecutada
model Search {
  id         String   @id @default(uuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  keywords   String
  location   String?
  remote     Boolean  @default(false)
  limit      Int
  count      Int
  topResults Json     // top 10 resultados para preview
  createdAt  DateTime @default(now())
}

// Búsquedas guardadas (alertas): re-ejecutar con un click
model SavedSearch {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  keywords  String
  location  String?
  remote    Boolean  @default(false)
  limit     Int      @default(30)
  createdAt DateTime @default(now())
}
